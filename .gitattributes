* text=auto
*.sh text eol=lf
*.csv text eol=lf
Dockerfile* text eol=lf
*.png binary

# Prettier uses LF inside Docker even when a Windows checkout uses autocrlf.
frontend/** text=auto eol=lf

# Preserve published evidence checksums across Windows and Git checkouts.
docs/evidence/restore-proof/**/*.json text eol=lf

# Preserve upstream font license and binary font bytes.
frontend/src/app/fonts/plex-LICENSE.txt -text
*.woff2 binary
