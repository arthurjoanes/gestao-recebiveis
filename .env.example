# O setup gera quatro segredos independentes; DATABASE_PASSWORD pertence somente ao admin.
# Preserve o .env de uma instalação existente; trocar esta senha não altera a senha do banco já criado.
# DEMO_MODE habilita somente contas e dados fictícios para demonstração local.
COMPOSE_PROJECT_NAME=pf-gestao-recebiveis
DEMO_MODE=true
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
DATABASE_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_OWNER_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
DATABASE_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
FRONTEND_PORT=3101
API_PORT=8101
FRONTEND_ORIGIN=http://localhost:3101
COOKIE_SECURE=false
# Configuração do worker.
MAX_ATTEMPTS=5
LEASE_SECONDS=60
HEARTBEAT_SECONDS=20
WORKER_POLL_SECONDS=1
DEMO_RETRY_BASE_SECONDS=1
